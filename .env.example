# Local dev (production values: docs/production-deploy.md)
VITE_OMNIROUTE_BASE_URL=http://localhost:3000
VITE_AI_BASE_URL=http://localhost:3000/v1
VITE_PUBLIC_WEB_URL=http://localhost:5173
VITE_WHATSAPP_NUMBER=6281990609939
VITE_WHATSAPP_MESSAGE=Hai admin Mikbalvia Digital, saya ingin bertanya tentang layanan Mind Aku.

# Announcement-only WhatsApp group (https://chat.whatsapp.com/...). Leave empty to hide join UI.
# VITE_WHATSAPP_GROUP_URL=

# Optional promo teaser (all three work together; omit to disable)
# VITE_COMMUNITY_CAMPAIGN_ID=aug2026-free-starter
# VITE_COMMUNITY_CAMPAIGN_TEASER=Free starter API key — klaim via chat admin
# VITE_COMMUNITY_CAMPAIGN_ENDS_AT=2026-08-31T23:59:59+07:00

# Payment success/cancel redirects are configured on OmniRoute
# (PAYMENT_SUCCESS_RETURN_URL / PAYMENT_CANCEL_RETURN_URL), or sent by the
# portal per request. SumoPod webhook URL is set in the SumoPod dashboard to:
#   https://<omniroute-host>/api/payments/webhook
# See docs/sumopod-payment-gateway.md
